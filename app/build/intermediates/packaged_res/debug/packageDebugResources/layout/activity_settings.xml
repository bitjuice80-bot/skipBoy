<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnOpenService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_open_service"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_update_rules"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnImport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_import_local"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnExport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_export_log"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnWhitelist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_whitelist"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/status_idle" />

    <Switch
        android:id="@+id/swDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="调试浮窗（实时显示日志）" />

    <TextView
        android:id="@+id/tvLog"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="8dp"
        android:background="#22000000"
        android:padding="8dp"
        android:textSize="11sp"
        android:textColor="#006400"
        android:scrollbars="vertical" />
</LinearLayout>
